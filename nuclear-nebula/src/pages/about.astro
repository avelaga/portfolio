---
import Navbar from "./layout/Navbar.astro"; // or .jsx if you keep it React 
import "./styles/pages.scss"; // move your pages.scss to src/styles/
import "./styles/global.scss"; // move your pages.scss to src/styles/

const resumeUrl = "/images/Resume.pdf"; // adjust if you put it in /files/

const bioHtml = `I'm a musician, interdisciplinary creator, and software developer based in Austin, TX, where I work as a senior software engineer at <processing>Visa</processing> and studied both Computer Science and Studio Art at <ut>The University of Texas at Austin</ut>. <br /><br />My career centers on building and shipping polished websites with a focus on tight UX, while my creative practice spans music, visual storytelling, and digital media. Most recently I've been passionate about documenting and sharing my journey learning how to work on cars on my <a href="https://youtube.com/@abhi.velaga" target="_blank"><yt>youtube channel</yt></a>.`;
---

<div class="page">
  <!-- Desktop -->
  <div class="about-desktop">
    <Navbar activeLink="ABOUT" mobile={false} />

    <div class="about-top">
      <img
        src="/images/music/indulgent/indulgentlive.jpg"
        class="about-top-img fadein"
        loading="lazy"
        decoding="async"
        alt="Room"
      />

      <div class="about-second-text" set:html={bioHtml}></div>

      <img
        src="/images/home/medrums.jpg"
        class="about-right-img fadein"
        loading="lazy"
        decoding="async"
        alt="Drums"
      />
    </div>

    <div class="about-bottom">
      <img
        src="/images/home/mecrop.jpg"
        class="about-bottom-img fadein"
        loading="lazy"
        decoding="async"
        alt="Portrait"
      />

      <div class="about-bottom-text">
    <a href="mailto:abhinav.velaga@utexas.edu">abhinav.velaga@utexas.edu</a>
    <br />
    <a href="https://www.instagram.com/abhi.velaga/" target='_blank'>@abhi.velaga</a>
    <br />
    <a href="https://www.instagram.com/abhi.film/" target='_blank'>@abhi.film</a>
    <br />
    <a href={resumeUrl} target='_blank'>[ resume ]</a>
    <br />
    <a href="youtube.com/@abhi.velaga" target='_blank'>youtube</a>
    <br />
    {/* <a href="https://dribbble.com/avelaga" target='_blank'>dribbble</a>
  <br /> */}
    <a href="https://www.github.com/avelaga/" target='_blank'>github</a>
    <br />
    <a href="https://shop.abhi.work" target='_blank'>merch</a>
    <br />
      </div>
    </div>
  </div>

  <!-- Mobile -->
  <div class="about-mobile">
    <Navbar activeLink="ABOUT" mobile={true} />

    <div class="appear">
      <img
        src="/images/home/mecrop.jpg"
        class="about-top-img fadein"
        loading="lazy"
        decoding="async"
        alt="Portrait"
      />

      <div class="about-first-text" set:html={bioHtml}></div>

      <img
        src="/images/home/medrums.jpg"
        class="about-bottom-img fadein"
        loading="lazy"
        decoding="async"
        alt="Drums"
      />

<div class="about-bottom-text">
    <a href="mailto:abhinav.velaga@utexas.edu">abhinav.velaga@utexas.edu</a>
    <br />
    <a href="https://www.instagram.com/abhi.velaga/" target='_blank'>@abhi.velaga</a>
    <br />
    <a href="https://www.instagram.com/abhi.film/" target='_blank'>@abhi.film</a>
    <br />
    <a href={resumeUrl} target='_blank'>[ resume ]</a>
    <br />
    <a href="youtube.com/@abhi.velaga" target='_blank'>youtube</a>
    <br />
    {/* <a href="https://dribbble.com/avelaga" target='_blank'>dribbble</a>
  <br /> */}
    <a href="https://www.github.com/avelaga/" target='_blank'>github</a>
    <br />
    <a href="https://shop.abhi.work" target='_blank'>merch</a>
    <br />
  </div>

      <img
        src="/images/music/indulgent/indulgentlive.jpg"
        class="about-right-img fadein"
        loading="lazy"
        decoding="async"
        alt="Room"
      />
    </div>
  </div>
</div>

<style>
  /* replaces MediaQuery breakpoint behavior */
  .about-desktop { display: block; }
  .about-mobile { display: none; }

  @media (max-width: 500px) {
    .about-desktop { display: none; }
    .about-mobile { display: block; }
  }

  /* optional: mimic LazyLoadImage opacity effect */
  .fadein {
    opacity: 0;
    animation: fadeIn 350ms ease forwards;
  }
  @keyframes fadeIn {
    to { opacity: 1; }
  }
</style>
