---
import Navbar from "./layout/Navbar.astro"; // if still React: "../layout/Navbar.jsx" + client:load
import BaseLayout from "./layout/BaseLayout.astro"

// Assumes these files now live under public/images/...
const images = {
  indulgentlive: "/images/music/indulgent/indulgentlive.jpg",
  guitar1: "/images/music/indulgent/guitar1.jpg",
  guitar2: "/images/music/indulgent/guitar2.jpg",

  caladan: "/images/music/caladan/caladan.jpg",
  caladanGroup: "/images/music/caladan/group.jpg",

  sd1: "/images/music/sd/sd1.jpg",
  fallingKid: "/images/music/sd/fallingKid.jpg",

  mjf: "/images/music/mjf/mjf.jpg",
  mjfStudio: "/images/music/mjf/studio.jpg",
  mjfCover: "/images/music/mjf/cover.jpg",
};

// Convert your old ./musicImports.js to a normal module that exports an array
// and import it here (recommended).
import { indulgentReleases } from "./data/musicImports.js";
// ^ move musicImports.js somewhere like src/data/musicImports.js
//   and ensure each releaseObj.cover is a public URL like "/images/music/indulgent/xxx.jpg"
---

<BaseLayout>
<div class="page">
  <div class="nav-desktop">
    <Navbar activeLink="MUSIC" mobile={false} />
  </div>
  <div class="nav-mobile">
    <Navbar activeLink="MUSIC" mobile={true} />
  </div>

  <div class="title">INDULGENT</div>
  <div class="section-subtitle">guitar, vocals, drums, bass</div>
  <div class="section-year">2015 - present</div>

  <img src={images.indulgentlive} class="music-full" loading="lazy" decoding="async" alt="Indulgent live" />

  <div class="music-description">
    I perform all vocals, drums, guitars, and bass myself for my solo project, Indulgent, and released my recent album,
    <a href="https://open.spotify.com/album/2d7c0N7uNdi3jfdsTWeZNV?si=K98wvkQmQd6uMvHFrQt2ng" target="_blank" rel="noopener noreferrer">
      No Drive Will Take Me Home
    </a>,
    in 2018 and my debut album,
    <a href="https://open.spotify.com/album/67RH1N86fW4hIA10m3DhFl?si=Hl4dag6_QhSyX3f4Zv0mhg" target="_blank" rel="noopener noreferrer">
      Toxic
    </a>,
    in 2015.
  </div>

  <img src={images.guitar1} class="half-left" loading="lazy" decoding="async" alt="Indulgent guitar 1" />
  <img src={images.guitar2} class="half-right" loading="lazy" decoding="async" alt="Indulgent guitar 2" />

  <div class="music-releases">
    {indulgentReleases.map((releaseObj) => (
      <div class="music-release">
        <a href={releaseObj.link} target="_blank" rel="noopener noreferrer">
          <img src={releaseObj.cover} class="music-cover" loading="lazy" decoding="async" alt={releaseObj.title} />
          {releaseObj.title}
          <br />
          {releaseObj.year}
        </a>
      </div>
    ))}
  </div>

  <div class="line"></div>

  <div class="title">CALADAN</div>
  <div class="section-subtitle">drums</div>
  <div class="section-year">2022 - 2023</div>

  <img src={images.caladan} class="music-full" loading="lazy" decoding="async" alt="Caladan" />

  <div class="music-video">
    <iframe
      class="youtube-half-left"
      src="https://www.youtube-nocookie.com/embed/VQsZdVG8A8I"
      title="Caladan - hole in the wall 1.7.23"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    ></iframe>
    hole in the wall <br />
    1.7.23
  </div>

  <div class="music-video">
    <iframe
      class="youtube-half-right"
      src="https://www.youtube-nocookie.com/embed/hQgL_IebL_s"
      title="Caladan - woodshed 12.17.22"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    ></iframe>
    woodshed <br /> 12.17.22
  </div>

  <img src={images.caladanGroup} class="music-full" loading="lazy" decoding="async" alt="Caladan group" />

  <div class="line"></div>

  <div class="title">SHIVERING DEMONS</div>
  <div class="section-subtitle">drums</div>
  <div class="section-year">2022 - 2023</div>

  <img src={images.sd1} class="music-full" loading="lazy" decoding="async" alt="Shivering Demons" />
  <img src={images.fallingKid} class="music-half" loading="lazy" decoding="async" alt="Falling kid" />

  <div class="music-video">
    <iframe
      class="youtube-half-right"
      src="https://www.youtube-nocookie.com/embed/1ap9ObDNqAU"
      title="Shivering Demons - far out lounge 1.13.23"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    ></iframe>
    far out lounge <br /> 1.13.23
  </div>

  <div class="music-video">
    <iframe
      class="youtube-half-left"
      src="https://www.youtube-nocookie.com/embed/08FnNPD-Eng"
      title="Shivering Demons - 11.11.22 rio market"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    ></iframe>
    11.11.22 <br /> rio market
  </div>

  <div class="music-video">
    <iframe
      class="youtube-half-right"
      src="https://www.youtube-nocookie.com/embed/6mEqHssj27Y"
      title="Shivering Demons - pearl st. co-op 10.28.22"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    ></iframe>
    pearl st. co-op <br /> 10.28.22
  </div>

  <div class="line"></div>

  <div class="title">MERRY JANE &amp; THE FONDAS</div>
  <div class="section-subtitle">drums</div>
  <div class="section-year">2018 - 2019</div>

  <img src={images.mjf} class="music-full" loading="lazy" decoding="async" alt="Merry Jane & The Fondas" />

  <div class="music-description">
    As the drummer for Merry Jane &amp; The Fondas from 2018 to 2019, I recorded a
    <a href="https://open.spotify.com/album/097Hlqmh6mqEv6GJbxf61L?si=NO5UrK5mTlymBRe4vKErNw" target="_blank" rel="noopener noreferrer">
      studio EP
    </a>
    with renowned guitarist and songwriter, Jackie Venson, and also played an
    <a href="https://schedule.sxsw.com/2019/artists/2008465" target="_blank" rel="noopener noreferrer">
      official SXSW showcase
    </a>.
  </div>

  <img src={images.mjfStudio} class="music-full" loading="lazy" decoding="async" alt="MJF studio" />

  <div class="music-video-full">
    <iframe
      class="youtube-full"
      src="https://www.youtube-nocookie.com/embed/XXMGt_N6Mc0"
      title="porchfire fest SXSW 3.10.19"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    ></iframe>
    porchfire fest SXSW <br /> 3.10.19
  </div>

  <div class="music-releases">
    <div class="music-release">
      <a href="https://open.spotify.com/album/097Hlqmh6mqEv6GJbxf61L?si=NO5UrK5mTlymBRe4vKErNw" target="_blank" rel="noopener noreferrer">
        <img src={images.mjfCover} class="music-cover" loading="lazy" decoding="async" alt="Pulls You Under cover" />
        Pulls You Under
        <br />
        2019
      </a>
    </div>
  </div>
</div>
</BaseLayout>

<style>
  /* replaces react-responsive MediaQuery */
  .nav-desktop { display: block; }
  .nav-mobile { display: none; }

  @media (max-width: 500px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
  }
</style>
